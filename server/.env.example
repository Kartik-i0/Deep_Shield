PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/deepshield
CLIENT_URL=http://localhost:5173
PYTHON_SERVICE_URL=http://127.0.0.1:8000/api/v1
MAX_FILE_SIZE_MB=50

# You can provide multiple Gemini API keys separated by commas for automatic rate-limit rotation!
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# You can provide multiple Hugging Face tokens separated by commas!
HF_API_TOKENS=hf_token_1,hf_token_2

